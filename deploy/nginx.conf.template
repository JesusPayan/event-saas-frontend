# Plantilla procesada por envsubst al iniciar el contenedor (imagen oficial nginx).
# Variables: API_UPSTREAM (p. ej. http://backend:5000)
# Conserva el esquema original si hay un proxy TLS delante (Caddy/CDN).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 20m;

    # Las cabeceras de seguridad se incluyen en CADA location: en nginx, un add_header
    # dentro de location anula los heredados del bloque server.
    include /etc/nginx/snippets/security-headers.conf;

    # API en el mismo origen: sin CORS ni credenciales en el navegador.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 60s;
        # nginx ya aplica estas cabeceras (snippet); evita duplicados del backend.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Strict-Transport-Security;
    }

    # Archivos con hash: caché larga.
    location ~* \.(?:js|css|woff2?|svg|png|jpg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # SPA: cualquier otra ruta resuelve a index.html (sin caché).
    location / {
        add_header Cache-Control "no-store";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
